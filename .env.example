# Copia este archivo como .env y llena tus valores reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# --- Django ---
# Genera una con: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambia_esto_por_una_clave_secreta
DEBUG=True

# Base de datos MySQL (crea la base antes: CREATE DATABASE gamevault;)
DB_NAME=gamevault
DB_USER=root
DB_PASSWORD=tu_password_de_mysql
DB_HOST=localhost
DB_PORT=

# Clave de la API de RAWG (gratis en https://rawg.io/apidocs)
RAWG_API_KEY=tu_clave_de_rawg_aqui

# Secreto para firmar los tokens JWT (usa una cadena larga y aleatoria, mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
